#!/system/bin/sh

JAR=${REGION_UNLOCK_JAR:-/system/etc/oplus-region-unlock.jar}
MAIN=dev.op13.regionunlock.RegionUnlock

if [ "$(id -u)" != "1000" ]; then
    command="CLASSPATH='$JAR' exec app_process /system/bin '$MAIN'"
    for argument in "$@"; do
        escaped=$(printf '%s' "$argument" | sed "s/'/'\\\\''/g")
        command="$command '$escaped'"
    done
    exec su 1000 -c "$command"
fi

CLASSPATH="$JAR" exec app_process /system/bin "$MAIN" "$@"
